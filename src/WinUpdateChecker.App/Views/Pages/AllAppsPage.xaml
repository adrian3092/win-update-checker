<Page
    x:Class="WinUpdateChecker.App.Views.Pages.AllAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WinUpdateChecker.App.ViewModels"
    Title="All apps">
    <Grid Margin="20,12,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="All apps" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SummaryText}" Margin="14,7,0,0" Opacity="0.6" FontSize="12" />
            </StackPanel>
            <ui:TextBox DockPanel.Dock="Right" Width="240" HorizontalAlignment="Right"
                        PlaceholderText="Filter apps…" ClearButtonEnabled="True"
                        Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <ListView Grid.Row="1" ItemsSource="{Binding Rows}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:UpdateRowViewModel}">
                    <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,5"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.7" Margin="0,0,12,0" />
                                <Border CornerRadius="9" Padding="8,1"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Visibility="{Binding IsUpdate, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Source}" FontSize="11" Opacity="0.8" />
                                </Border>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Publisher}" Opacity="0.55" FontSize="12" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Current}" Opacity="0.6" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
